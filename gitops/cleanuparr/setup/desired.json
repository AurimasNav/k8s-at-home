  "downloadCleaner": {
    "enabled": true,
    "cronExpression": "0 0 * * * ?",
    "ignoredDownloads": [
      "21b481771e3c64ed694fc219b9d8c03953d52965",
      "00fd62b34d3b3c874dc0715eb11dbe5e811846ab"
    ]
  },
  "queueCleaner": {
    "enabled": true,
    "cronExpression": "0 0/5 * * * ?",
