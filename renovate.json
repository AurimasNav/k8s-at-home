{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "dependencyDashboard": true,
  "dependencyDashboardAutoclose": false,
  "branchConcurrentLimit": 100,
  "prConcurrentLimit": 0,
  "prHourlyLimit": 20,
  "pruneStaleBranches": true,
  "separateMajorMinor": false,
  "gitIgnoredAuthors": ["fake@mail.com"],
  "packageRules": [
    {
      "description": "Plex tags are <major>.<minor>.<patch>.<build>-<git hash>; compare the numbers, ignore the hash and per-arch tags",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["plexinc/pms-docker"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\.(?<build>\\d+)-[0-9a-f]+$"
    },
    {
      "description": "Our Home Assistant image (AurimasNav/home-assistant-image) is tagged <Home Assistant version>.<build number>, e.g. 2026.11.1.2: four numbers, compared as such",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/aurimasnav/home-assistant-image"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\.(?<build>\\d+)$"
    },
    {
      "description": "hairsera images are private on ghcr.io and Renovate has no ghcr login, so every run warned \"Failed to look up docker package ... no-result\". hairsera's own deploy workflow already sets these tags here on each build, so Renovate skips them",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/aurimasnav/hairsera", "ghcr.io/aurimasnav/hairsera-migrate"],
      "enabled": false
    },
    {
      "description": "VSeerr tags are <Seerr release>-vseerr.<VSeerr MAJOR.MINOR.PATCH>, e.g. 3.5.1-vseerr.0.4.2: plain semver. The '-vseerr' part makes every tag a semver pre-release, so ignoreUnstable is off. Only that form is followed: main/sha-* tags and the old 3.5.1-vseerr.<build> tags (which sort above the new ones) are never offered",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/aurimasnav/vseerr"],
      "versioning": "semver",
      "ignoreUnstable": false,
      "allowedVersions": "/^\\d+\\.\\d+\\.\\d+-vseerr\\.\\d+\\.\\d+\\.\\d+$/"
    },
    {
      "description": "hass-otbr-docker also publishes git-hash tags (e.g. 7781566); only follow vX.Y.Z releases",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/ownbee/hass-otbr-docker"],
      "allowedVersions": "/^v\\d+\\.\\d+\\.\\d+$/"
    },
    {
      "description": "Immich server and machine-learning must run the same release: one PR for both",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/immich-app/immich-server", "ghcr.io/immich-app/immich-machine-learning"],
      "groupName": "immich"
    },
    {
      "description": "Immich Postgres (<pg>-vectorchord<x>-pgvector<y>): a Postgres major needs a dump/restore and a VectorChord bump an ALTER EXTENSION, so it is upgraded by hand following Immich's compose file",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/immich-app/postgres"],
      "enabled": false
    },
    {
      "description": "iac/ uses OpenTofu: resolve providers and modules from the OpenTofu registry",
      "matchManagers": ["terraform"],
      "matchDatasources": ["terraform-provider", "terraform-module"],
      "registryUrls": ["https://registry.opentofu.org"]
    },
    {
      "description": "required_version is an OpenTofu range, not a Terraform release; the tofu binary is pinned in .github/workflows/iac.yaml",
      "matchManagers": ["terraform"],
      "matchDepTypes": ["required_version"],
      "enabled": false
    }
  ],
  "enabledManagers": ["kubernetes", "kustomize", "custom.regex", "github-actions", "terraform", "pip_requirements"],
  "kubernetes": {
    "managerFilePatterns": ["/gitops/.*/.*\\.ya?ml$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/gitops/.*/.*\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+- name: \\S+\\s+value: \"?(?<currentValue>[^\"\\s]+)\"?"
      ],
      "extractVersionTemplate": "^v?(?<version>.*)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/kustomization\\.yaml/"],
      "matchStrings": [
        "https://github\\.com/(?<depName>.*/.*?)/releases/download/(?<currentValue>.*?)/"
      ],
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/kustomization\\.yaml/"],
      "matchStrings": [
        "https://raw\\.githubusercontent\\.com/(?<depName>[^/]*/[^/]*)/(?<currentValue>.*?)/"
      ],
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/kustomization\\.yaml/"],
      "matchStrings": [
        "https://github\\.com/(?<depName>[^/]+/[^/]+)/archive/refs/tags/(?<currentValue>.+?)\\.tar\\.gz"
      ],
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "description": "Tool versions in GitHub workflow env",
      "managerFilePatterns": ["/^\\.github/workflows/.*\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( extractVersion=(?<extractVersion>\\S+))?\\s+[A-Z_]+: \"(?<currentValue>[^\"]+)\""
      ],
      "extractVersionTemplate": "{{#if extractVersion}}{{{extractVersion}}}{{else}}^v?(?<version>.*)${{/if}}"
    }
  ]
}
