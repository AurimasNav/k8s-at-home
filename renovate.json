{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "dependencyDashboard": true,
  "dependencyDashboardAutoclose": false,
  "branchConcurrentLimit": 100,
  "prConcurrentLimit": 0,
  "prHourlyLimit": 20,
  "pruneStaleBranches": true,
  "separateMajorMinor": false,
  "gitIgnoredAuthors": ["fake@mail.com"],
  "packageRules": [
    {
      "description": "Plex tags are <major>.<minor>.<patch>.<build>-<git hash>; compare the numbers, ignore the hash and per-arch tags",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["plexinc/pms-docker"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\.(?<build>\\d+)-[0-9a-f]+$"
    },
    {
      "description": "hass-otbr-docker also publishes git-hash tags (e.g. 7781566); only follow vX.Y.Z releases",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/ownbee/hass-otbr-docker"],
      "allowedVersions": "/^v\\d+\\.\\d+\\.\\d+$/"
    },
    {
      "description": "iac/ uses OpenTofu: resolve providers and modules from the OpenTofu registry",
      "matchManagers": ["terraform"],
      "matchDatasources": ["terraform-provider", "terraform-module"],
      "registryUrls": ["https://registry.opentofu.org"]
    },
    {
      "description": "required_version is an OpenTofu range, not a Terraform release; the tofu binary is pinned in .github/workflows/iac.yaml",
      "matchManagers": ["terraform"],
      "matchDepTypes": ["required_version"],
      "enabled": false
    }
  ],
  "enabledManagers": ["kubernetes", "kustomize", "custom.regex", "github-actions", "terraform"],
  "kubernetes": {
    "managerFilePatterns": ["/gitops/.*/.*\\.ya?ml$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/gitops/.*/.*\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+- name: \\S+\\s+value: \"?(?<currentValue>[^\"\\s]+)\"?"
      ],
      "extractVersionTemplate": "^v?(?<version>.*)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/kustomization\\.yaml/"],
      "matchStrings": [
        "https://github\\.com/(?<depName>.*/.*?)/releases/download/(?<currentValue>.*?)/"
      ],
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/kustomization\\.yaml/"],
      "matchStrings": [
        "https://raw\\.githubusercontent\\.com/(?<depName>[^/]*/[^/]*)/(?<currentValue>.*?)/"
      ],
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/kustomization\\.yaml/"],
      "matchStrings": [
        "https://github\\.com/(?<depName>[^/]+/[^/]+)/archive/refs/tags/(?<currentValue>.+?)\\.tar\\.gz"
      ],
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "description": "Tool versions in GitHub workflow env",
      "managerFilePatterns": ["/^\\.github/workflows/.*\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( extractVersion=(?<extractVersion>\\S+))?\\s+[A-Z_]+: \"(?<currentValue>[^\"]+)\""
      ],
      "extractVersionTemplate": "{{#if extractVersion}}{{{extractVersion}}}{{else}}^v?(?<version>.*)${{/if}}"
    }
  ]
}
