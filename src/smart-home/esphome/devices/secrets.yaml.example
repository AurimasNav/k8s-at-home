# ESPHome Secrets Template
# Copy this file to secrets.yaml in this directory (src/smart-home/esphome/devices/secrets.yaml)
# ESPHome resolves !secret references relative to the device config's directory,
# so all device configs share this one secrets.yaml.

wifi_ssid: "Your_WiFi_SSID"
wifi_password: "Your_WiFi_Password"
ha_ip_address: "192.168.1.10"
# HA's k8s node IP (hostNetwork: true) — ports outside the LoadBalancer service,
# like nibegw's UDP, are reachable here, not on ha_ip_address.
ha_node_ip: "192.168.1.NN"

ap_password: "Fallback_AP_Password"

api_encryption_key: "GENERATE_BASE64_32_BYTE_KEY_HERE="
ota_password: "Your_OTA_Password"
